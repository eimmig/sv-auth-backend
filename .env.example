# Copie para .env (nunca versionado - ver .gitignore) e preencha os valores reais.
# Ver docs/OBSERVABILITY-AND-CONFIG.md. So o que o codigo desta feature realmente le -
# demais variaveis (chave PASETO etc.) sao acrescentadas pelas features que as consomem
# (feat-005/feat-006).

# Conexao Postgres (perfil dev - ver src/main/resources/application.yml).
# DB_HOST/DB_PORT/DB_NAME/DB_USER tem default para o container local (infra/docker-compose.yml,
# postgres-auth) - so precisam ser sobrescritos se o ambiente for diferente do padrao.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth
DB_USER=auth_user
DB_PASSWORD=CHANGE_ME

# Segredo estatico do header X-Admin-Api-Key (rota administrativa de provisionamento de
# tenant, feat-003) - uso exclusivo do operador da plataforma, ver docs/API-CONTRACTS.md.
ADMIN_API_KEY=CHANGE_ME

# Chave simetrica PASETO v4.local (feat-005, emissao de token no login) - 32 bytes em hex
# (64 chars), gerar com `openssl rand -hex 32`. MESMA chave sera configurada em
# services/api-gateway quando epic-008 existir (quem valida o token) - nao gerar uma
# independente la, ou os tokens emitidos aqui ficam indecifraveis. Ver
# docs/OBSERVABILITY-AND-CONFIG.md.
PASETO_LOCAL_KEY=CHANGE_ME
