# Copie para .env e preencha os valores reais.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth
DB_USER=auth_user
DB_PASSWORD=CHANGE_ME

# Segredo do header X-Admin-Api-Key
ADMIN_API_KEY=CHANGE_ME

# Chave PASETO v4.local, 32 bytes em hex (`openssl rand -hex 32`), a mesma do api-gateway
PASETO_LOCAL_KEY=CHANGE_ME
